{
  "name": "sheetpress",
  "version": "1.0.0",
  "description": "Markdown in, single-file HTML explainer page out. Library-first: import renderDoc, or use the bundled zero-dependency CLI.",
  "type": "module",
  "bin": {
    "sheetpress": "bin/sheetpress.js",
    "sp": "bin/sheetpress.js",
    "am": "bin/am.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" \"test/**/*.test.js\""
  },
  "keywords": [
    "llm",
    "agent",
    "skill",
    "html",
    "explainer",
    "diagram",
    "ste100",
    "markdown"
  ],
  "license": "MIT",
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "marked": "^18.0.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10xdev4u-alt/sheetpress.git"
  },
  "homepage": "https://github.com/10xdev4u-alt/sheetpress#readme",
  "bugs": {
    "url": "https://github.com/10xdev4u-alt/sheetpress/issues"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "exports": {
    ".": "./src/index.js",
    "./render": "./src/render.js",
    "./parse": "./src/parse.js",
    "./lint": "./src/lint/ste.js",
    "./components": "./src/components/index.js"
  }
}
